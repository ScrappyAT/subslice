# ---- Database ----
# Local Postgres from docker-compose.yml. Port 5434 is deliberate:
# the auth-slice project uses 5433, and these must never collide.
DATABASE_URL="postgresql://subslice:PASSWORD@localhost:5434/subslice?schema=public"

# ---- Flutterwave (test mode only) ----
# Settings > API keys > V3 Test API keys > Secret key.
# The v3 base URL is a config constant, not an env var — see AGENTS.md.
FLW_SECRET_KEY=

# A random string you generate yourself, then paste into
# Settings > Webhooks > Secret hash and save. Must match exactly.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FLW_SECRET_HASH=

# ---- App ----
# Public base URL used to build Flutterwave's redirect_url.
# http://localhost:3000 locally; your tunnel URL when testing webhooks.
APP_BASE_URL="http://localhost:3000"

# ---- Auth (imported from Assessment 1) ----
# TODO: copy the session and email variables from auth-slice/.env.example
