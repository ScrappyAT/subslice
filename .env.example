# Copy this file to .env and fill in real values by hand. Never commit .env.

# PostgreSQL connection string for Prisma.
# e.g. postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Flutterwave secret key (test mode). Used to authenticate server-side calls
# to the Flutterwave API — payment initiation and transaction verification.
# From the Flutterwave dashboard, test mode, API keys page.
FLW_SECRET_KEY=

# Flutterwave webhook shared secret ("secret hash"), set in the Flutterwave
# dashboard's webhook settings. NOT the same value as FLW_SECRET_KEY above —
# this one is compared against the `verif-hash` header on incoming webhooks,
# it is not used to call the API.
FLW_SECRET_HASH=

# This app's own public base URL, used to build the redirect_url sent to
# Flutterwave when initiating a checkout (e.g. http://localhost:3000, or the
# tunnel URL when testing webhooks locally).
APP_BASE_URL=
