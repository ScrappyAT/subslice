generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Carried over from Assessment 1. Reused, not rebuilt.
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions            Session[]
  verificationCodes   VerificationCode[]
  passwordResetTokens PasswordResetToken[]
  paymentEvents       PaymentEvent[]
  subscription        Subscription?
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  code       String    @db.Char(6)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------------------------------------------------------------------------
// Assessment 2
// ---------------------------------------------------------------------------

enum BillingInterval {
  NONE
  MONTH
  YEAR
}

/// The three sellable plans. Seeded by migration, not created at runtime.
/// amountMinor is an integer in the currency's smallest unit — kobo for NGN,
/// cents for USD. Never a float, never a Decimal.
model Plan {
  code        String          @id // "free" | "monthly" | "yearly"
  name        String
  amountMinor Int
  currency    String          @db.Char(3)
  interval    BillingInterval
  active      Boolean         @default(true)

  subscriptions        Subscription[] @relation("SubscriptionPlan")
  pendingSubscriptions Subscription[] @relation("SubscriptionPendingPlan")
  paymentEvents        PaymentEvent[]

  @@index([active])
}

/// PRORATION_QUOTED and CANCELLATION_REASON_PROVIDED replace UPGRADE_PRORATED
/// and SUBSCRIPTION_EXPIRED from the original draft:
/// - There is no event for expiry. Nothing schedules it, and expiry is
///   derived from `now > currentPeriodEnd` the same way a scheduled downgrade
///   is derived — a stored SUBSCRIPTION_EXPIRED row would need a cron job to
///   write it and would duplicate information already in currentPeriodEnd.
/// - The proration quote shown to the user before they confirm an upgrade is
///   its own event, written at initiation, and it grants nothing. Only
///   ENTITLEMENT_GRANTED moves the plan or the period, so there is exactly
///   one event type that can be the answer to "show me where entitlement is
///   granted".
/// - The cancellation reason is its own event because it can arrive after
///   CANCELLATION_REQUESTED, and the log is append-only — the requested row
///   cannot be edited to add a reason later.
enum PaymentEventType {
  CHECKOUT_INITIATED
  PRORATION_QUOTED
  PAYMENT_VERIFIED
  ENTITLEMENT_GRANTED
  PAYMENT_FAILED
  WEBHOOK_RECEIVED
  WEBHOOK_DUPLICATE_IGNORED
  DOWNGRADE_SCHEDULED
  CANCELLATION_REQUESTED
  CANCELLATION_REASON_PROVIDED
}

/// APPEND ONLY. Rows are inserted, never updated, never deleted.
/// This table is the source of truth for what a user is entitled to.
/// Subscription is a projection derived from these rows and must be
/// rebuildable from them alone.
model PaymentEvent {
  id     String           @id @default(cuid())
  seq    Int              @unique @default(autoincrement())
  userId String
  type   PaymentEventType

  /// Which plan this event concerns, where relevant. A foreign key, not a
  /// free string, so an invalid plan code can never enter the log.
  planCode String?

  /// Two reference fields, two jobs. txRef is ours and identifies one
  /// checkout attempt — it is what CHECKOUT_INITIATED, PRORATION_QUOTED and
  /// PAYMENT_FAILED key their idempotency on, since a retry after failure
  /// uses a new one. providerReference is Flutterwave's numeric transaction
  /// id, the anchor for verification and fulfilment — PAYMENT_VERIFIED,
  /// ENTITLEMENT_GRANTED, WEBHOOK_RECEIVED and WEBHOOK_DUPLICATE_IGNORED key
  /// their idempotency on this one instead, deliberately, since collision on
  /// it is the point. Both are stored, because a dispute months later needs
  /// to trace both "which checkout attempt" and "which provider transaction".
  txRef             String?
  providerReference String?

  /// Integer minor units. Null for events that move no money, such as
  /// CHECKOUT_INITIATED before an amount is fixed, or CANCELLATION_REQUESTED.
  amountMinor Int?
  currency    String? @db.Char(3)

  /// Proration: unused value carried over from the previous plan, in minor
  /// units. Set on PRORATION_QUOTED (what the user was shown) and again on
  /// ENTITLEMENT_GRANTED (what was actually credited against the charge that
  /// granted access), so the arithmetic is reconstructable from the log
  /// alone rather than only from application logs.
  creditAppliedMinor Int?

  /// The period this event establishes or ends, where relevant.
  periodStart DateTime?
  periodEnd   DateTime?

  /// Failure reason, or the user's cancellation reason.
  reason String?

  /// The raw provider payload as received, for dispute evidence. Never
  /// contains card data — the provider does not send it and must not be asked
  /// for it.
  payload Json?

  /// The uniqueness anchor. Composed from the event type and the provider
  /// reference (or another natural key for events with no provider reference).
  /// The unique constraint — not an application-level check — is what makes a
  /// repeated webhook record once.
  idempotencyKey String @unique

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planCode], references: [code], onDelete: Restrict)

  /// (userId, seq) is the actual derivation query: filter by user, replay in
  /// seq order. There is no (userId, createdAt) index — nothing queries the
  /// log by user ordered by wall-clock time instead of seq.
  @@index([userId, seq])
  @@index([txRef])
  @@index([providerReference])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLING
  EXPIRED
}

/// A DERIVED PROJECTION of PaymentEvent, kept for cheap reads.
/// Nothing here is authoritative. If this table and the event log disagree,
/// the event log is right and this row is rebuilt.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  /// Foreign keys, not free strings, so the projection can never point at a
  /// plan code that does not exist.
  planCode String
  status   SubscriptionStatus

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  /// Set true by a cancellation request. Access continues until
  /// currentPeriodEnd — never an immediate cutoff.
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelledAt        DateTime?
  cancellationReason String?

  /// A scheduled downgrade. Applied at currentPeriodEnd, not immediately.
  pendingPlanCode String?

  /// The seq of the last PaymentEvent this projection reflects, held by
  /// value rather than by foreign key. Drift detection is a comparison
  /// against max(seq) in the log — an id cannot do that, a seq can.
  lastEventSeq Int?

  updatedAt DateTime @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan  @relation("SubscriptionPlan", fields: [planCode], references: [code])
  pendingPlan Plan? @relation("SubscriptionPendingPlan", fields: [pendingPlanCode], references: [code], onDelete: Restrict)

  @@index([currentPeriodEnd])
}
